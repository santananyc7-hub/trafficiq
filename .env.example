# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# ── Database ────────────────────────────────────────────────────────────────
# Empty = embedded PGlite (local, zero service). Set to a free Neon pooled URL in prod.
DATABASE_URL=

# ── Dutchie POS API ─────────────────────────────────────────────────────────
# HTTP Basic auth: key as username, blank password. Key comes from Dutchie Support.
DUTCHIE_API_KEY=
DUTCHIE_BASE_URL=https://api.pos.dutchie.com
# Transactions endpoint path + date params vary by API version — confirm in your
# key-gated API Explorer; the sync prints the live response shape on first run.
DUTCHIE_TRANSACTIONS_PATH=/transactions

# ── Alpine IQ (loyalty / CRM) ───────────────────────────────────────────────
# Header auth: X-APIKEY. uid is your account id (in the Alpine IQ dashboard URL).
ALPINEIQ_API_KEY=
ALPINEIQ_UID=
ALPINEIQ_BASE_URL=https://lab.alpineiq.com/api/v1

# ── VeriScan (door traffic / ID scan → home ZIP) ────────────────────────────
# CSV export path (visitor history with a ZIP column) works on normal tiers.
VERISCAN_EXPORT_CSV=
# API (Export Historical Data) needs the Enterprise tier enabled by IDScan.
VERISCAN_API_TOKEN=
VERISCAN_BASE_URL=

# ── Marketing spend (the one input not in POS) — optional ───────────────────
# Path to a small CSV of channel,date,spend to compute CAC/ROAS.
SPEND_CSV=
